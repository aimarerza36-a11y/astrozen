---
import type { HeroProps } from "@types";

type Props = HeroProps;

const { name, specialty, summary, email } = Astro.props;
---

<section class="flex min-h-[calc(100vh-90px)] items-center">
  <div class="mx-auto w-full max-w-5xl -translate-y-4 px-8 py-16 lg:px-12">

    <h1 class="max-w-4xl text-5xl font-bold leading-[1.05] tracking-[-0.02em] text-[#171b18] sm:text-6xl lg:text-7xl">
      {name} <span class="font-normal text-[#59615a]">(萬俊陽)</span>
    </h1>

    <h2 class="mt-6 text-3xl font-bold leading-tight text-[#2f6b3f] sm:text-4xl lg:text-5xl">
      {specialty}
    </h2>

    <p class="mt-7 max-w-3xl text-xl font-normal leading-relaxed text-[#59615a] sm:text-2xl">
      {summary}
    </p>

    <a
      class="mt-9 inline-flex items-center gap-4 rounded-full bg-[#2f6b3f] px-8 py-4 text-base font-semibold !text-[#ffffff] transition-colors hover:bg-[#255632]"
      href={`mailto:${email}`}
    >
      Get in Touch
      <span aria-hidden="true" class="text-lg !text-[#ffffff]">→</span>
    </a>

  </div>
</section>
