---
import type { SiteContent } from "@types";

interface Props {
  awards: SiteContent["awards"];
}

const { awards } = Astro.props;
---

<section id="awards" class="px-8 py-24 lg:px-12">
  <div class="mx-auto max-w-5xl">

    <div class="mb-12">
  
      <h2 class="text-4xl font-bold tracking-tight text-[#171b18] sm:text-5xl">
        Honors & awards
      </h2>
    </div>

    <div class="grid gap-8 sm:grid-cols-2">
      {awards.map((item) => (
        <article class="rounded-2xl border border-[#dfe4df] p-7">
          <p class="text-sm font-medium text-[#2f6b3f]">
            {item.date}
          </p>

          <h3 class="mt-3 text-xl font-semibold leading-snug text-[#171b18]">
            {item.title}
          </h3>

          <p class="mt-3 text-base leading-relaxed text-[#59615a]">
            {item.organization}
          </p>
        </article>
      ))}
    </div>

  </div>
</section>
