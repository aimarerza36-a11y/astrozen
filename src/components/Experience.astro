---
import type { ExperienceProps } from "../types";

interface Props {
  experience: ExperienceProps[];
}

const { experience } = Astro.props;
---

<section id="experience" class="py-20 sm:py-24">
  <div class="mb-12">

    <h2 class="text-3xl font-bold tracking-tight text-[#1c211d] sm:text-4xl">
      Professional Experience
    </h2>
  </div>

  <div class="space-y-12">
    {
      experience.map((item) => (
        <article class="grid gap-3 border-t border-[#dfe4df] pt-7 sm:grid-cols-[180px_1fr] sm:gap-10">
          <div class="text-sm font-medium text-[#6f756f]">
            {item.startDate} — {item.endDate}
          </div>

          <div>
            <h3 class="text-xl font-bold tracking-tight text-[#1c211d]">
              {item.position}
            </h3>

            <p class="mt-1 text-base font-medium text-[#2f6b3f]">
              {item.company}
            </p>

            <div class="mt-4 space-y-2 text-[0.95rem] leading-7 text-[#59615a]">
              {
                Array.isArray(item.summary) ? (
                  item.summary.map((point) => <p>• {point}</p>)
                ) : (
                  <p>{item.summary}</p>
                )
              }
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
