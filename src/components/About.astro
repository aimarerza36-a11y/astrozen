---
import type { OpedProps } from "@types";

interface Props {
  opeds: OpedProps[];
}

const { opeds } = Astro.props;
---

<section id="about" class="border-t border-[#dfe4df] py-20 sm:py-24">
  <div class="grid gap-10 sm:grid-cols-[180px_1fr] sm:gap-10">

    <div>
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-[#2f6b3f]">
        About
      </p>
    </div>

    <div class="max-w-3xl">
      <div
        class="prose prose-lg max-w-none text-[#59615a] [&_em]:text-[#1c211d] [&_em]:font-medium"
        set:html={description}
      />

      <div class="mt-8 flex items-center gap-4">
        <Image
          src={image}
          width="56"
          height="56"
          alt={name}
          class="h-14 w-14 rounded-full object-cover"
        />

        <p class="text-sm font-semibold text-[#1c211d]">
          {name}
        </p>
      </div>
    </div>

  </div>
</section>
