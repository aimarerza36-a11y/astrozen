---
import type { SiteConfig } from "@types";

type Props = Pick<SiteConfig, "author" | "socialLinks">;

const { author, socialLinks } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer
  class="w-full border-t border-[#dfe4df] px-5 pt-5 pb-8 text-center text-[#1c211d]"
>
  <ul class="mb-5 flex flex-wrap justify-center gap-x-5 text-xs">
    {
      socialLinks.map(({ text, href }) => (
        <li>
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-4 py-3 text-[#1c211d] transition-colors hover:text-[#2f6b3f]"
          >
            {text}
          </a>
        </li>
      ))
    }
  </ul>

  <p class="text-xs text-[#1c211d]">
    {author} © {currentYear}.
    <span class="text-[#6f756f]">
      Designed &amp; Developed by
    </span>
    {" "}Moisés Machuca
  </p>
</footer>
