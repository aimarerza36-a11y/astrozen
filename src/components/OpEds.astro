---
import type { OpedProps } from "@types";

interface Props {
  opeds: OpedProps[];
}

const { opeds } = Astro.props;
---

<section id="opeds" class="mx-auto max-w-6xl px-6 py-24 sm:px-8">
  <div class="mb-12">

    <h2 class="text-4xl font-bold tracking-tight text-[#171b18] sm:text-5xl">
      Op-eds
    </h2>
  </div>

  <div class="divide-y divide-[#dfe4df] border-y border-[#dfe4df]">
    {
      opeds.map((item) => (
        <article class="py-8">
          <div class="grid gap-4 md:grid-cols-[1fr_auto] md:gap-12">
            <div>
              <h3 class="text-2xl font-semibold leading-tight text-[#171b18]">
                {item.title}
              </h3>

              <p class="mt-4 flex items-center gap-2 text-base text-[#59615a]">
                {item.logo && (
                  <img
                    src={item.logo}
                    alt={`${item.publication} logo`}
                    class="h-5 w-5 rounded-sm border border-[#dfe4df] bg-white object-contain p-0.5"
                    loading="lazy"
                  />
                )}
                {item.publication}
              </p>
            </div>

            <div class="text-sm font-medium text-[#59615a] md:text-right">
              {item.date}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
