---
import type { OpedProps } from "@types";

interface Props {
  opeds: OpedProps[];
}

const { opeds } = Astro.props;
---

<section id="opeds" class="mx-auto max-w-6xl px-6 py-24 sm:px-8">
  <div class="mb-12">
    <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-[#46734b]">
      Selected Writing
    </p>

    <h2 class="text-4xl font-extrabold tracking-tight text-[#171b18] sm:text-5xl">
      Op-eds
    </h2>
  </div>

  <div class="divide-y divide-[#e2e5e1] border-y border-[#e2e5e1]">
    {
      opeds.map((item) => (
        <article class="py-8">
          <div class="grid gap-4 md:grid-cols-[1fr_auto] md:gap-12">
            <div>
              <h3 class="text-2xl font-bold leading-tight text-[#171b18]">
                {item.title}
              </h3>

              <p class="mt-4 text-base text-[#59615a]">
                {item.publication}
              </p>
            </div>

            <div class="text-sm font-medium text-[#59615a] md:text-right">
              {item.date}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
