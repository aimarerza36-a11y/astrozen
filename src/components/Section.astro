---
interface Props {
  text: string;
  href: string;
}

const { text, href } = Astro.props;
---

<section id={href} class="mx-auto max-w-6xl px-6 py-20 sm:px-8">
  <h2 class="font-sans text-4xl font-bold tracking-tight text-[#1c211d] sm:text-5xl">
    {text}
  </h2>

  <div class="mt-10">
    <slot />
  </div>
</section>
